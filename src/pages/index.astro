          </div>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-body">
              <div class="timeline-header">
                <div>
                  <p class="timeline-role">Senior Front End Developer</p>
                  <p class="timeline-company">Nekkanti Systems Pvt. Ltd.</p>
                </div>
                <span class="timeline-period">Aug 2016 – Oct 2021</span>
