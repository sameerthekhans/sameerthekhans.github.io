      <!-- Profiles -->
      <div class="card card--profiles" id="contact">
        <span class="eyebrow">FIND ME AT</span>
        <h3>Profiles</h3>
        <div class="profile-links">
          <a href="https://github.com/sameerthekhans" target="_blank" rel="noopener" class="profile-link">
            <svg class="profile-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>
          <a href="https://linkedin.com/in/sameerthekhans" target="_blank" rel="noopener" class="profile-link">
            <svg class="profile-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a href="mailto:sameerthekhans@gmail.com" class="profile-link">
            <svg class="profile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,12 2,6"/></svg>
            <span>Email</span>
          </a>
        </div>
        <a href="mailto:sameerthekhans@gmail.com" class="card-arrow" aria-label="Send email">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <!-- Stats -->
      <div class="card card--stats">
        <div class="stat">
          <p class="stat-number"><span class="stat-count" data-target="9">0</span>+</p>
          <p class="stat-label">Years Experience</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <p class="stat-number"><span class="stat-count" data-target="15">0</span></p>
          <p class="stat-label">Team Members Led</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <p class="stat-number"><span class="stat-count" data-target="5">0</span>K+</p>
          <p class="stat-label">Stack Overflow Reps</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="card card--cta">
        <span class="cta-star">✦</span>
        <p class="cta-text">Let's<br />work <span class="cta-accent">together.</span></p>
        <a href="mailto:sameerthekhans@gmail.com" class="card-arrow card-arrow--cta" aria-label="Get in touch">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

    </main>

    <!-- Footer -->
    <footer class="footer">
      <a href="/" class="footer-logo">SK</a>
      <nav class="footer-nav" aria-label="Footer">
        <a href="#home">Home</a>
        <a href="#experience">Experience</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
      <p class="footer-copy">© 2025 Sameer Khan. All rights reserved.</p>
    </footer>

  </body>
</html>

<style>
  /* ── Nav ─────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--muted-text);
  }

  .nav-links a:hover { color: var(--text); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-cta {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--border-hover);
    border-radius: 100px;
    color: var(--text);
    transition: border-color 0.2s, color 0.2s;
  }

  .nav-cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

/* ── Bento Grid ──────────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 0.75rem;
    padding: 0.75rem 2rem;
    margin-bottom: 2rem;
  }

  /* ── Card Base ───────────────────────────────────── */
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
    box-shadow: var(--card-shadow);
  }

  .eyebrow {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  .card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1rem;
  }

  /* ── Card Arrow ──────────────────────────────────── */
  .card-arrow {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border-hover);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-text);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .card:hover .card-arrow {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0, 229, 255, 0.06);
  }

  /* ── Grid Placement ──────────────────────────────── */
  .card--hero        { grid-column: 1 / 3; grid-row: 1 / 3; }
  .card--role        { grid-column: 3 / 4; grid-row: 1 / 2; }
  .card--about       { grid-column: 3 / 4; grid-row: 2 / 3; }
  .card--skills      { grid-column: 1 / 2; grid-row: 3 / 4; }
  .card--experience  { grid-column: 2 / 4; grid-row: 3 / 4; }
  .card--achievements{ grid-column: 1 / 2; grid-row: 4 / 5; }
  .card--education   { grid-column: 2 / 3; grid-row: 4 / 5; }
  .card--profiles    { grid-column: 3 / 4; grid-row: 4 / 5; }
  .card--stats       { grid-column: 1 / 3; grid-row: 5 / 6; }
  .card--cta         { grid-column: 3 / 4; grid-row: 5 / 6; }

  /* ── Hero Card ───────────────────────────────────── */
  .card--hero {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 2.5rem;
  }

  .hero-photo {
    position: relative;
    flex-shrink: 0;
    width: 220px;
    height: 280px;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    z-index: 1;
  }

  .hero-photo-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  .hero-content {
    flex: 1;
  }

  .hero-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .hero-name-muted {
    color: var(--muted);
  }

  .hero-tagline {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--muted-text);
    max-width: 360px;
    margin-bottom: 1.5rem;
  }

  .hero-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-pill {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border-hover);
    border-radius: 100px;
    color: var(--muted-text);
  }

  /* ── Role Card ───────────────────────────────────── */
  .role-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--surface-2);
    border: 1px solid var(--border-hover);
    border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .role-company {
    font-size: 0.8rem;
    color: var(--muted-text);
    margin-top: -0.75rem;
    margin-bottom: 0.4rem;
  }

  .role-period {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ── About Card ──────────────────────────────────── */
  .about-text {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--muted-text);
  }

  /* ── Skills Card ─────────────────────────────────── */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .tag {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted-text);
    transition: border-color 0.2s, color 0.2s;
  }

  .card:hover .tag { border-color: var(--border-hover); }

  .tag--primary {
    border-color: rgba(0, 229, 255, 0.25);
    color: var(--accent);
    background: rgba(0, 229, 255, 0.05);
  }

  /* ── Experience Card ─────────────────────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .timeline-item {
    display: flex;
    gap: 1rem;
  }

  .timeline-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.35rem;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.4);
  }

