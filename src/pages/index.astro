---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeroCard from "../components/cards/HeroCard.astro";
import RoleCard from "../components/cards/RoleCard.astro";
import AboutCard from "../components/cards/AboutCard.astro";
import SkillsCard from "../components/cards/SkillsCard.astro";
import ExperienceCard from "../components/cards/ExperienceCard.astro";
import AchievementsCard from "../components/cards/AchievementsCard.astro";
import EducationCard from "../components/cards/EducationCard.astro";
import ProfilesCard from "../components/cards/ProfilesCard.astro";
import StatsCard from "../components/cards/StatsCard.astro";
import CtaCard from "../components/cards/CtaCard.astro";

const epamStart = new Date(2024, 9, 1); // Oct 2024
const now = new Date();
const totalMonths =
  (now.getFullYear() - epamStart.getFullYear()) * 12 +
  (now.getMonth() - epamStart.getMonth());
const yrs = Math.floor(totalMonths / 12);
const mos = totalMonths % 12;
const epamTenure = yrs > 0
  ? `${yrs} yr${yrs > 1 ? "s" : ""} ${mos > 0 ? `${mos} mo` : ""}`.trim()
  : `${totalMonths}+ mos`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sameer Khan — Lead Software Engineer with 9+ years of experience building scalable full-stack web applications." />
    <title>Sameer Khan | Senior MEAN Stack Developer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'light' || (!saved && !prefersDark)) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main class="bento" id="home">
      <HeroCard />
      <RoleCard tenure={epamTenure} />
      <AboutCard />
      <SkillsCard />
      <ExperienceCard />
      <AchievementsCard />
      <EducationCard />
      <ProfilesCard />
      <StatsCard />
      <CtaCard />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* ── Bento Grid ──────────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(220px, auto);
    gap: 0.75rem;
    padding: 0.75rem 2rem;
    margin-bottom: 2rem;
  }

  /* ── Grid Placement ──────────────────────────────── */
  .card--hero        { grid-column: 1 / 3; grid-row: 1 / 3; }
  .card--role        { grid-column: 3 / 4; grid-row: 1 / 2; }
  .card--about       { grid-column: 3 / 4; grid-row: 2 / 3; }
  .card--skills      { grid-column: 1 / 2; grid-row: 3 / 4; }
  .card--experience  { grid-column: 2 / 4; grid-row: 3 / 4; }
  .card--achievements{ grid-column: 1 / 2; grid-row: 4 / 5; }
  .card--education   { grid-column: 2 / 3; grid-row: 4 / 5; }
  .card--profiles    { grid-column: 3 / 4; grid-row: 4 / 5; }
  .card--stats       { grid-column: 1 / 3; grid-row: 5 / 6; }
  .card--cta         { grid-column: 3 / 4; grid-row: 5 / 6; }

  /* ── Mobile ──────────────────────────────────────── */
  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: auto;
    }

    .card--hero        { grid-column: 1 / -1; grid-row: auto; flex-direction: column; }
    .card--role        { grid-column: auto; grid-row: auto; }
    .card--about       { grid-column: auto; grid-row: auto; }
    .card--skills      { grid-column: 1 / -1; grid-row: auto; }
    .card--experience  { grid-column: 1 / -1; grid-row: auto; }
    .card--achievements{ grid-column: auto; grid-row: auto; }
    .card--education   { grid-column: auto; grid-row: auto; }
    .card--profiles    { grid-column: auto; grid-row: auto; }
    .card--stats       { grid-column: 1 / -1; grid-row: auto; }
    .card--cta         { grid-column: auto; grid-row: auto; }

    .hero-photo { width: 100%; height: 200px; }
  }

  @media (max-width: 540px) {
    .bento { grid-template-columns: 1fr; padding: 0.75rem 1rem; }
    .card--achievements,
    .card--education,
    .card--profiles,
    .card--role,
    .card--about    { grid-column: 1 / -1; }
  }

  /* ── Reduced Motion ──────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
</style>
