---
---
<div class="card card--hero">
  <div class="hero-photo">
    <img src="/sameer-logo.jpg" alt="Sameer Khan" class="hero-photo-img" />
    <div class="hero-photo-badge">Available</div>
  </div>
  <div class="hero-content">
    <span class="eyebrow">A MEAN STACK DEVELOPER</span>
    <h1 class="hero-name">Sameer<br /><span class="hero-name-muted">Khan.</span></h1>
    <p class="hero-tagline">
      I build fast, scalable full-stack web applications —
      from database to deployment.
    </p>
    <div class="hero-pills">
      <span class="hero-pill">Angular</span>
      <span class="hero-pill">Node.js</span>
      <span class="hero-pill">TypeScript</span>
    </div>
  </div>
  <a href="mailto:sameerthekhans@gmail.com" class="card-arrow" aria-label="Contact me">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>

<style>
  .card--hero {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 2.5rem;
  }

  .hero-photo {
    position: relative;
    flex-shrink: 0;
    width: 220px;
    height: 280px;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero-photo-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  .hero-content {
    flex: 1;
  }

  .hero-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .hero-name-muted {
    color: var(--muted);
  }

  .hero-tagline {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--muted-text);
    max-width: 360px;
    margin-bottom: 1.5rem;
  }

  .hero-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-pill {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border-hover);
    border-radius: 100px;
    color: var(--muted-text);
  }

  @media (max-width: 900px) {
    .card--hero { flex-direction: column; }
    .hero-photo { width: 100%; height: 200px; }
  }
</style>
