---
---
<div class="card card--stats">
  <div class="stat">
    <p class="stat-number">9+</p>
    <p class="stat-label">Years Experience</p>
  </div>
  <div class="stat-divider"></div>
  <div class="stat">
    <p class="stat-number">15</p>
    <p class="stat-label">Team Members Led</p>
  </div>
  <div class="stat-divider"></div>
  <div class="stat">
    <p class="stat-number">5K+</p>
    <p class="stat-label">Stack Overflow Reps</p>
  </div>
</div>

<style>
  .card--stats {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 1rem;
    padding: 2rem 2.5rem;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .stat-divider {
    width: 1px;
    height: 60px;
    background: var(--border);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .card--stats { flex-wrap: wrap; padding: 1.5rem; gap: 1.5rem; }
    .stat-divider { display: none; }
  }
</style>
