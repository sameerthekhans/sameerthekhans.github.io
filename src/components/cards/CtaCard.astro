---
<div class="card card--cta">
  <span class="cta-star">✦</span>
  <p class="cta-text">Let's<br />work <span class="cta-accent">together.</span></p>
  <a href="mailto:sameerthekhans@gmail.com" class="card-arrow card-arrow--cta" aria-label="Get in touch">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</div>

<style>
  .card--cta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface-2);
  }

  .cta-star {
    font-size: 2rem;
    color: var(--muted);
    line-height: 1;
  }

  .cta-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .cta-accent {
    color: var(--accent);
  }

  .card-arrow--cta {
    position: static;
    align-self: flex-end;
    margin-top: 1rem;
    width: 48px;
    height: 48px;
  }
</style>
