---
---
<div class="card card--education">
  <span class="eyebrow">BACKGROUND</span>
  <h3>Education</h3>
  <div class="edu-list">
    <div class="edu-item">
      <p class="edu-degree">PG — MBA Finance</p>
      <p class="edu-school">Azad College, Hyderabad</p>
      <span class="edu-year">2019</span>
    </div>
    <div class="edu-divider"></div>
    <div class="edu-item">
      <p class="edu-degree">B.Com (Computers)</p>
      <p class="edu-school">St. Pauls Degree College</p>
      <span class="edu-year">2016</span>
    </div>
  </div>
  <p class="self-taught">Self-taught developer ✦</p>
</div>

<style>
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .edu-degree {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .edu-school {
    font-size: 0.75rem;
    color: var(--muted-text);
    margin-top: 0.15rem;
  }

  .edu-year {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--muted);
    margin-top: 0.2rem;
    letter-spacing: 0.06em;
  }

  .edu-divider {
    height: 1px;
    background: var(--border);
    margin: 0.25rem 0;
  }

  .self-taught {
    margin-top: 1rem;
    font-size: 0.72rem;
    color: var(--accent);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
</style>
