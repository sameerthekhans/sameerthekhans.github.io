---
---
<header class="nav">
  <a href="/" class="nav-logo"><img src="/sameer-logo-xs.png" alt="Sameer Khan" class="nav-logo-img" /></a>
  <nav class="nav-links" aria-label="Primary">
    <a href="#home">Home</a>
    <a href="#experience">Experience</a>
    <a href="#skills">Skills</a>
    <a href="#contact">Contact</a>
  </nav>
  <div class="nav-actions">
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <svg class="theme-icon theme-icon--sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="theme-icon theme-icon--moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <a href="mailto:sameerthekhans@gmail.com" class="nav-cta">Let's talk</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    display: flex;
    align-items: center;
  }

  .nav-logo-img {
    height: 32px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--muted-text);
  }

  .nav-links a:hover { color: var(--text); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-cta {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--border-hover);
    border-radius: 100px;
    color: var(--text);
    transition: border-color 0.2s, color 0.2s;
  }

  .nav-cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--border-hover);
    border-radius: 50%;
    background: transparent;
    color: var(--muted-text);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0, 229, 255, 0.06);
  }

  .theme-icon--moon { display: none; }
  .theme-icon--sun  { display: block; }

  :global([data-theme="light"]) .theme-icon--sun  { display: none; }
  :global([data-theme="light"]) .theme-icon--moon { display: block; }
  :global([data-theme="light"]) .theme-toggle:hover { background: rgba(0, 151, 178, 0.08); }

  @media (max-width: 900px) {
    .nav-links { display: none; }
  }

  @media (max-width: 540px) {
    .nav { padding: 0.875rem 1rem; }
  }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.dataset.theme === 'light' ? 'dark' : 'light';
    html.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
